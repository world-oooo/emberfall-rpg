{
  "name": "emberfall-rpg",
  "private": true,
  "version": "1.0.0-rc.1",
  "description": "Emberfall - a small, complete 2D top-down action RPG vertical slice for the web (Phaser 4 + TypeScript + Vite).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:production": "npm run build && playwright test --config playwright.production.config.ts",
    "maps:build": "node --experimental-transform-types tools/maps/build-maps.ts",
    "maps:validate": "node --experimental-transform-types tools/maps/validate-maps.ts",
    "check": "npm run typecheck && npm run test && npm run maps:validate",
    "test:perf": "playwright test --config playwright.perf.config.ts",
    "test:shots": "playwright test --config playwright.shots.config.ts",
    "test:matrix": "playwright test --config playwright.matrix.config.ts"
  },
  "dependencies": {
    "idb-keyval": "~6.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "~1.62.1",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "~8.2.2",
    "vitest": "~5.0.0"
  }
}
